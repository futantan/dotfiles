theme = Catppuccin Macchiato

# Shell integrations
shell-integration = fish
quit-after-last-window-closed = true

font-family = ""
font-family = "MonoLisa"
font-family = "FiraCode Nerd Font"
font-family = "Sarasa Term SC"
font-style = Regular
font-style-italic = Regular Italic
font-style-bold = Bold
font-style-bold-italic = Bold Italic
font-size = 16
# this solves the issue of displaying chinese characters
grapheme-width-method = unicode

# background-blur-radius = 20
background-opacity = 1

# Cursor style
cursor-style-blink = true
cursor-style = block

# Clipboard settings
clipboard-read = allow
clipboard-write = allow

macos-option-as-alt = true


# macos options
macos-option-as-alt = true
macos-titlebar-proxy-icon = hidden

adjust-cell-height = 35%
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2

# window-padding-x = 16
# window-padding-y = 16
window-padding-balance = true
window-save-state = always
# window-decoration = none
macos-titlebar-style = hidden
# window-colorspace = "display-p3"
title = ""

window-inherit-working-directory = true
working-directory = inherit
keybind = shift+enter=text:\x1b\r

# Ctrl-Alt-number: jump to Herdr/tmux tabs via the shared Ctrl-Space prefix.
keybind = ctrl+alt+1=text:\x001
keybind = ctrl+alt+2=text:\x002
keybind = ctrl+alt+3=text:\x003
keybind = ctrl+alt+4=text:\x004
keybind = ctrl+alt+5=text:\x005
keybind = ctrl+alt+6=text:\x006
keybind = ctrl+alt+7=text:\x007
keybind = ctrl+alt+8=text:\x008
keybind = ctrl+alt+9=text:\x009
